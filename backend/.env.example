# ─── InterviewIQ-AI Backend — Environment Variables ─────────────────────────
# Copy this file to .env and fill in your own values.
# NEVER commit the actual .env file — it is gitignored.

# ── Gemini AI ─────────────────────────────────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
#
# Option A — Multi-key pool (recommended for production):
#   Provide a comma-separated list of keys. The service will round-robin
#   across them and apply per-key circuit breakers when one hits a rate limit.
#   GEMINI_API_KEYS=AIza...key1,AIza...key2,AIza...key3
#
# Option B — Single key (legacy / development):
#   GEMINI_API_KEY=AIza...yourkey
#
# If both are set, GEMINI_API_KEYS takes priority; GEMINI_API_KEY is used
# as a last-resort fallback. Duplicates are automatically deduplicated.
GEMINI_API_KEYS=your_gemini_api_key_here

# ── Database (Neon Postgres) ──────────────────────────────────────────────────
# Get your connection string from: https://console.neon.tech
# Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ── Server ────────────────────────────────────────────────────────────────────
# Port the NestJS server listens on (defaults to 3000 if not set)
PORT=3000
